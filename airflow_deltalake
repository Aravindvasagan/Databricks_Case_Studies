from airflow.sdk import dag, task

@dag( dag_id="first_dag")
def first_dag():
    @task.python    
    def print_hello():
        print("Hello from airflow-tutorial!")
    @task.python
    def print_goodbye():
        print("Goodbye from airflow-tutorial!")
    
    @task.python
    def print_greeting(greeting: str):
        print(greeting) 


    #define tasks dependencies
    first_dag = print_hello()
    second_dag = print_goodbye()
    third_dag = print_greeting("Hello, Airflow!")
    #print_hello >> print_greeting("Hello, Airflow!") >> print_goodbye()

    #define the order of execution of the tasks
    first_dag >> third_dag >> second_dag

#instantiate the DAG (register  the dag)
first_dag = first_dag()
